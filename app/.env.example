# Clerk browser publishable key. Secret key stays on canonical server.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional exact Clerk audience. Leave empty when session tokens have no audience.
CLERK_AUDIENCE=
# Exact browser/server origin. Development may use loopback HTTP only.
MINARBOT_ORIGIN=http://127.0.0.1:4317
MINARBOT_SERVER_URL=http://127.0.0.1:4317
MINARBOT_CANONICAL_DB=
# Canonical HTTPS certificate/key are required outside development.
MINARBOT_TLS_CERT=
MINARBOT_TLS_KEY=
# Clerk Google connection is configured in Clerk. No Google client secret belongs here.
# Mail delivery uses native fetch and Resend's API; no mail SDK is required.
RESEND_API_KEY=
MINARBOT_MAIL_FROM=
MINARBOT_INSTALLATION_ID=

# Set up Linux Computer in Settings > Computer, then enable it per agent.
# Headless device override: 1 enables Computer and 0 disables it.
# MINARBOT_AGENT_DESKTOP=1
# MINARBOT_AGENT_DESKTOP_MAX=2
# MINARBOT_AGENT_DESKTOP_IDLE_MS=900000

# Optional local project folders root. Must be inside Owner home, outside protected folders.
# Default: ~/Minarbot/Projects (each project gets its own slug folder).
# MINARBOT_PROJECT_ROOT=/home/you/Minarbot/Projects
