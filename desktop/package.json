{
  "name": "minarbot-desktop",
  "version": "0.10.3",
  "private": true,
  "description": "Minarbot desktop client shell",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test src/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron-builder": "26.16.1",
    "electron": "44.10.1"
  },
  "build": {
    "appId": "com.minarbot.desktop",
    "productName": "Minarbot",
    "asar": true,
    "files": [
      "src/**/*",
      "!src/**/*.test.mjs",
      "assets/**/*",
      "NOTICE",
      "provenance.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "executableName": "minarbot",
      "syncDesktopName": true
    },
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/labsiqbal/minarbot/releases/latest/download/"
      }
    ],
    "artifactName": "Minarbot-${version}-${arch}.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "directories": {
      "output": "dist"
    }
  },
  "author": "Minarbot",
  "license": "Apache-2.0 AND MIT",
  "desktopName": "com.minarbot.desktop"
}
